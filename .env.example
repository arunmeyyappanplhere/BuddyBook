# ---------------------------------------------------------------------------
# BuddyBook frontend — environment variables
# ---------------------------------------------------------------------------
# Copy this file to ".env", then fill in / adjust the values. Vite only
# exposes variables prefixed with VITE_ to the client bundle.
# ---------------------------------------------------------------------------

# Base URL of the BuddyBook backend API.
# (The "/api" suffix is appended automatically in src/api/axios.js)
# Production backend (Render):
VITE_API_BASE_URL=https://buddybookbackend.onrender.com
# Local development (backend running on port 8000):
# VITE_API_BASE_URL=http://localhost:8000

# EmailJS configuration — used by the Help / contact-support form
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
