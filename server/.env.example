# MonogoDB Connection URI
MONGO_URI=

# Server Port
PORT=

# JWT Authentication
# Secret key used to sign JSON Web Tokens. Use a long random string in production.
JWT_SECRET=

# JWT token expiration (e.g. 1h, 7d, 30d)
JWT_EXPIRES_IN=

# Backwards-compatible alias for JWT_SECRET (used by older deployments)
JWT_LOGIN_SECRET=

# Cloudinary Configuration
# Cloud name, API key, and API secret for Cloudinary image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=